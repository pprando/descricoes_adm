# Exemplo de configuração do Cloudflare com D1
# Ajuste conforme sua conta e projeto no Cloudflare

name = "nuxt-app"
compatibility_date = "2024-01-01"

# Configuração do D1 Database
# O binding "DB" será acessível como event.context.cloudflare.env.DB
[[d1_databases]]
binding = "DB"
database_name = "acompanhamento_descricoes"  # Substitua pelo nome do seu banco
database_id = "seu-database-id-aqui"         # Substitua pelo ID do seu banco
